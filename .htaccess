ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Permanently gone - old WordPress paths (return 410 Gone for fast deindex)
RedirectMatch 410 ^/services(/.*)?$
RedirectMatch 410 ^/team/.*$
RedirectMatch 410 ^/author/.*$
RedirectMatch 410 ^/faq-items/.*$
RedirectMatch 410 ^/wp-content/.*$
RedirectMatch 410 ^/wp-admin/.*$
RedirectMatch 410 ^/wp-includes/.*$
RedirectMatch 410 ^/wp-json/.*$
RedirectMatch 410 ^/photo-gallery/.*$
RedirectMatch 410 ^/clients/.*$
RedirectMatch 410 ^/[0-9]{4}/[0-9]{2}/.*$
RedirectMatch 410 ^/feed/?$
RedirectMatch 410 ^/comments/feed/?$

RewriteEngine On

# Force HTTPS + non-www in a single hop (avoids redirect chains)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.acsoconsulting\.com$ [NC]
RewriteRule ^(.*)$ https://acsoconsulting.com/$1 [L,R=301]

# Strip index.html
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Legacy WP query params (lang, gallery, p, etc.) - 410 so Google deindexes fast
RewriteCond %{QUERY_STRING} (^|&)(lang|gallery|p|page_id|cat|m|s)= [NC]
RewriteRule ^.*$ - [R=410,L]

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Without this the HTTPS redirect above is still one cleartext request that a
  # network attacker can intercept before it happens. Deliberately no
  # includeSubDomains and no preload: webmail and other host subdomains have not
  # been verified as HTTPS-only, and both of those are hard to walk back.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # The site uses none of these. Denying them stops an injected or third-party
  # script, including the analytics tags, from reaching for a device API.
  Header set Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
</IfModule>
